[Unit]
Description=Tro & Viec Sach nightly maintenance (US-901)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/troviec
# TAG = the release currently deployed (deploy.yml writes DEPLOYED_TAG). $$ keeps the substitution for sh.
ExecStart=/bin/sh -c 'TAG=$$(cat DEPLOYED_TAG) /usr/bin/docker compose -f docker-compose.prod.yml run --rm maintenance'
