# =============================================================================
# Trọ & Việc Sạch — biến môi trường. Sao chép thành .env (KHÔNG commit .env).
# Sinh khóa ngẫu nhiên: openssl rand -base64 32   |   openssl rand -hex 32
# Ý nghĩa từng biến: docs/08-deployment.md, mục Biến môi trường.
# =============================================================================

# ---- Chung ----
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# ---- PostgreSQL (db/init/00_init.sh đọc các biến này khi khởi tạo lần đầu) ----
POSTGRES_PASSWORD=change-me-superuser
# Cổng trên máy host; đổi (ví dụ 5433) nếu máy đã có PostgreSQL chiếm 5432, nhớ sửa Port trong ConnectionStrings__*
POSTGRES_HOST_PORT=5432
APP_MIGRATOR_PASSWORD=change-me-migrator
APP_API_PASSWORD=change-me-api
APP_WORKER_PASSWORD=change-me-worker
APP_MAINTENANCE_PASSWORD=change-me-maintenance
APP_REPORTING_PASSWORD=change-me-reporting
APP_RESEARCH_PASSWORD=change-me-research

# ---- Garage (S3) ----
# Bí mật RPC của Garage (openssl rand -hex 32); không ghi vào infra/garage/garage.toml
GARAGE_RPC_SECRET=replace-with-hex-32-bytes

# ---- API (.NET; khóa lồng dùng "__") ----
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Main=Host=localhost;Port=5432;Database=troviec;Username=app_api;Password=change-me-api
# Job đêm (TroViec.Maintenance) dùng role riêng; không dùng chung ConnectionStrings__Main
ConnectionStrings__Maintenance=Host=localhost;Port=5432;Database=troviec;Username=app_maintenance;Password=change-me-maintenance
ConnectionStrings__Migrator=Host=localhost;Port=5432;Database=troviec;Username=app_migrator;Password=change-me-migrator
ConnectionStrings__Redis=localhost:6379
Jwt__SigningKey=replace-with-base64-32-bytes
Jwt__Issuer=https://localhost
Jwt__Audience=https://localhost
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
# Tên miền email sinh viên, cách nhau dấu phẩy — XÁC NHẬN với nhà trường trước khi dùng
Auth__StudentEmailDomains=sv.example.edu.vn
S3__Endpoint=http://localhost:3900
S3__Region=garage
# Khóa Garage "troviec-app" (đọc/ghi 3 bucket) — dùng cho api và maintenance
S3__AccessKey=replace-with-garage-key-id
S3__SecretKey=replace-with-garage-secret
S3__BucketListingImages=listing-images
S3__BucketScanImages=scan-images
S3__BucketOwnerDocuments=owner-documents
# Dev: Garage website mode định tuyến theo Host <bucket>.web.garage.localhost (*.localhost trỏ về máy mình)
S3__PublicMediaBaseUrl=http://listing-images.web.garage.localhost:3902
# Dùng chung với worker (IDENTIFIER_HMAC_KEY) — hai giá trị PHẢI giống nhau; cả hai giải mã base64 thành 32 byte làm khóa
Crypto__IdentifierHmacKey=replace-with-base64-32-bytes
Crypto__DocumentKeys={"k1":"replace-with-base64-32-bytes"}
Crypto__ActiveDocumentKeyId=k1
Crypto__SignedUrlKey=replace-with-base64-32-bytes
# Dev: Mailpit. Production miễn phí: Brevo SMTP (smtp-relay.brevo.com:587, 300 email/ngày)
Smtp__Host=localhost
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__From=Tro & Viec Sach <no-reply@example.com>
# console: chỉ dev (in OTP ra log). Production không có nhà cung cấp SMS: none + admin xác thực số thủ công
Sms__Provider=console
Embed__BaseUrl=http://localhost:8001
Embed__InternalToken=replace-with-hex-32-bytes
Embed__TimeoutMs=800
Quota__GuestScansPerDay=5
Quota__UserScansPerDay=50
Campuses__Json=[{"code":"main","name":"Cơ sở chính","lat":21.0537,"lng":105.7353}]
# Gốc URL của web, dùng trong link gửi qua email (đặt lại mật khẩu). Production: https://{DOMAIN}
App__SiteUrl=http://localhost:3000
Cors__AllowedOrigins=http://localhost:3000
# Proxy tin cậy cho X-Forwarded-For (CIDR, cách nhau dấu phẩy). Dev: loopback; production: mạng Docker nội bộ của Caddy và web
ForwardedHeaders__KnownNetworks=127.0.0.1/32,::1/128
# Chỉ dùng cho lệnh bootstrap-admin, xóa sau khi tạo xong admin đầu tiên
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=

# ---- Worker (Python) ----
DATABASE_URL=postgresql://app_worker:change-me-worker@localhost:5432/troviec
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
# Khóa Garage "troviec-worker" (CHỈ ĐỌC scan-images, listing-images) — khác khóa của API
S3_ACCESS_KEY=replace-with-garage-worker-key-id
S3_SECRET_KEY=replace-with-garage-worker-secret
S3_BUCKET_SCAN_IMAGES=scan-images
S3_BUCKET_LISTING_IMAGES=listing-images
IDENTIFIER_HMAC_KEY=replace-with-base64-32-bytes
# Để trống LLM_* = chỉ dùng luật từ khóa (chạy được không cần API key, 0 đồng).
# LLM_MODEL phải trùng <model-id> của dòng model_versions 'llm' đang chạy; lệch thì worker chỉ dùng luật.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=7
# Đặt thấp hơn hạn mức request/ngày của gói LLM miễn phí đang dùng
LLM_DAILY_CALL_LIMIT=800
# 1 = dùng llm/fake.py (chỉ dev/CI/E2E); production luôn 0
LLM_FAKE=0
INTERNAL_API_TOKEN=replace-with-hex-32-bytes
MODEL_DIR=./.models
HF_HOME=./.models/hf
WORKER_FAKE_PIPELINE=0
LOG_LEVEL=INFO

# ---- Web (Next.js) ----
API_INTERNAL_URL=http://localhost:8080
# Trình duyệt gọi API: dev khác origin; production để trống (cùng origin qua Caddy)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---- Sao lưu (chỉ production, bật ở T4.4) ----
# Mặc định miễn phí: Backblaze B2 (S3 API), ví dụ WALG_S3_PREFIX=s3://<bucket>/wal, AWS_ENDPOINT=https://s3.<region>.backblazeb2.com
WALG_S3_PREFIX=
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WALG_LIBSODIUM_KEY=
