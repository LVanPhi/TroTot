  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.1.2" />
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Npgsql" Version="11.0.0" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="Pgvector.Dapper" Version="0.3.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.1.1" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TroViec.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TroViec.Security\TroViec.Security.csproj" />
  </ItemGroup>

</Project>
